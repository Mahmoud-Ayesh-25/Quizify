<Page x:Class="Quizify_Project.Pages.FinalResult"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quizify_Project.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FinalResult"
      Loaded="Page_Loaded"
      x:Name="Final"
      Opacity="1"
      RenderOptions.BitmapScalingMode="HighQuality">

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:2" From="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Final"></DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="60"></RowDefinition>
            </Grid.RowDefinitions>

        <Border Background="#55000000" CornerRadius="20" Margin="10"> 
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition ></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition ></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock x:Name="Level" Text="GOOD" Foreground="Green" FontSize="70" HorizontalAlignment="Center" VerticalAlignment="Center"
        FontFamily="Bahnschrift" FontWeight="Bold" Grid.Row="1" RenderOptions.BitmapScalingMode="HighQuality"></TextBlock>

                <TextBlock x:Name="AnsweredQuestions" Text="Questions  9 / 10" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
FontFamily="Arial" Grid.Row="2" RenderOptions.BitmapScalingMode="HighQuality"></TextBlock>

                <TextBlock x:Name="Mark" Text="Mark  6.75 / 10" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
FontFamily="Arial" Grid.Row="3" RenderOptions.BitmapScalingMode="HighQuality"></TextBlock>

                <TextBlock x:Name="Persentage" Text="67.5%" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
FontFamily="Arial" Grid.Row="4" RenderOptions.BitmapScalingMode="HighQuality"></TextBlock>

                <TextBlock Text="mahmoud'ayesh" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
FontFamily="Gigi" Grid.Row="5" RenderOptions.BitmapScalingMode="HighQuality"></TextBlock>

            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ButtonContainer" Grid.Row="1"></StackPanel>


    </Grid>


</Page>
