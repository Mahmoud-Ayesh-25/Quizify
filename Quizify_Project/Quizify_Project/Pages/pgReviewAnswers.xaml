<Page x:Class="Quizify_Project.Pages.pgReviewAnswers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quizify_Project.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgReviewAnswers"
      Loaded="Page_Loaded"
      x:Name="ReviewAnswers"
      Opacity="1"
      RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Review Answers" Grid.Column="0" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"
    Foreground="White" FontFamily="Arial" TextTrimming="CharacterEllipsis"></TextBlock>
            
            <TextBlock Text="C#/Why C#" x:Name="PathText" Grid.Column="1" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"
    Foreground="White" FontFamily="Arial" TextTrimming="CharacterEllipsis"></TextBlock>

        </Grid>
        
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Border x:Name="brdr" Grid.Column="1"></Border>

                <StackPanel Width="{Binding ElementName=brdr, Path=ActualWidth}" Orientation="Vertical" x:Name="ElementsContainer" Grid.Column="1"></StackPanel>
            </Grid>
            
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="200"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ExitSP" Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"></StackPanel>
            <StackPanel x:Name="ShowResultSP" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"></StackPanel>
            
        </Grid>
        
    </Grid>
</Page>
