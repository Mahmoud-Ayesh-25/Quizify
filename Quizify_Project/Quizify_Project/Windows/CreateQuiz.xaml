<Window x:Class="Quizify_Project.Windows.CreateQuiz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizify_Project.Windows"
        xmlns:class="clr-namespace:Quizify_Project.Classes"
        xmlns:userControls="clr-namespace:Quizify_Project.UserControls"
        mc:Ignorable="d" Height="300" Width="350"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        MaxHeight="300" MaxWidth="350"
        MinHeight="300" MinWidth="350"
        Loaded="Window_Loaded"
        x:Name="CreateQuizWindow"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">
    
    <Window.Resources>
        <class:clsHalfConverter x:Key="HalfConverter"></class:clsHalfConverter>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" CenterX="225" CenterY="120" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.3" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF343D66" BorderThickness="2">

            <Border.Background>
                <ImageBrush ImageSource="/Images/Background/MainBackground.png"/>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="60"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PathText" Foreground="#eeffffff" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0 10 0 0"></TextBlock>
                        
                        <userControls:CustomComboBox x:Name="QuestionCountCB" Width="325" Height="45" Grid.Row="1" OnSelectedItemChanged="QuestionCountCB_OnSelectedItemChanged"></userControls:CustomComboBox>
                        
                        <userControls:CustomComboBox x:Name="QuesitonTimeCB" Width="325" Height="45" Grid.Row="2" OnSelectedItemChanged="QuesitonTimeCB_OnSelectedItemChanged"></userControls:CustomComboBox>
                        
                    </Grid>                 

                    <StackPanel x:Name="ButtonsSP" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    </StackPanel>

                </Grid>
                
                <Border Grid.Row="0" Background="#FF111731" CornerRadius="10 10 0 0" BorderThickness="1" BorderBrush="#FF343D66">

                    <Border.Effect>
                        <DropShadowEffect Direction="270" BlurRadius="50" Opacity="0.4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DragBorder" Background="Transparent" MouseDown="DragBorder_MouseDown" Grid.Column="0" Panel.ZIndex="2"/>

                        <TextBlock x:Name="EdgeText" Text="Create Quiz" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18 0 0 0" FontSize="25" Foreground="White"
                                   FontWeight="Bold" FontFamily="Calibri"></TextBlock>
                        
                        <Border x:Name="CloseBTN" CornerRadius="5" Grid.Column="1" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="CloseBTN_MouseUp">

                            <Border.Background>
                                <SolidColorBrush x:Name="CloseBTNColor" Color="Transparent"/>
                            </Border.Background>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.15" To="#33ff0000" Storyboard.TargetName="CloseBTNColor" Storyboard.TargetProperty="Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.15" To="Transparent" Storyboard.TargetName="CloseBTNColor" Storyboard.TargetProperty="Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Image Source="/Images/Buttons/close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                    </Grid>

                </Border>
            </Grid>
            
        </Border>
    </Grid>
</Window>
