<Window x:Class="Quizify_Project.Windows.Questions.AddEditLesson"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizify_Project.Windows"
        xmlns:class="clr-namespace:Quizify_Project.Classes"
        xmlns:userControls="clr-namespace:Quizify_Project.UserControls"
        mc:Ignorable="d" Height="240" Width="750"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        MaxHeight="240" MaxWidth="750"
        MinHeight="240" MinWidth="750"
        Loaded="Window_Loaded"
        x:Name="LessonWindow"
        Opacity="0"
        RenderOptions.BitmapScalingMode="HighQuality">
    
    <Window.Resources>
        <class:clsHalfConverter x:Key="HalfConverter"></class:clsHalfConverter>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" CenterX="375" CenterY="120" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.3" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF343D66" BorderThickness="2">

            <Border.Background>
                <ImageBrush ImageSource="/Images/Background/MainBackground.png"/>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TitleRow"></RowDefinition>
                        <RowDefinition Height="60"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="ButtonsSP" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    </StackPanel>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock Foreground="White" Text="Title:" FontWeight="Bold" Margin="10"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"></TextBlock>

                            <StackPanel x:Name="TitleSwitchSP" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 0" Grid.Row="2">
                                <userControls:Switch x:Name="TitleSwitch" Width="40" Height="20" Margin="10 4 10 0" OnStatusChanged="TitleSwitch_OnStatusChanged"></userControls:Switch>
                                <TextBlock x:Name="TitleRTLText" Foreground="White" Text="Right To Left"
                                VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="17"></TextBlock>
                            </StackPanel>

                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="2" Margin="10 10 0 10">
                            <userControls:CustomTextBox x:Name="TitleText" Width="725" MaxLength="255" Height="45"
                                         VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" OnTextChanged="TitleText_TextChanged">
                            </userControls:CustomTextBox>
                        </ScrollViewer>

                    </Grid>

                </Grid>
                
                <Border Grid.Row="0" Background="#FF111731" CornerRadius="10 10 0 0" BorderThickness="1" BorderBrush="#FF343D66">

                    <Border.Effect>
                        <DropShadowEffect Direction="270" BlurRadius="50" Opacity="0.4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DragBorder" Background="Transparent" MouseDown="DragBorder_MouseDown" Grid.Column="0" Panel.ZIndex="2"/>

                        <TextBlock x:Name="EdgeText" Text="Question Details" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18 0 0 0" FontSize="25" Foreground="White"
                                   FontWeight="Bold" FontFamily="Calibri"></TextBlock>
                        
                        <Border x:Name="CloseBTN" CornerRadius="5" Grid.Column="1" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="CloseBTN_MouseUp">

                            <Border.Background>
                                <SolidColorBrush x:Name="CloseBTNColor" Color="Transparent"/>
                            </Border.Background>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.15" To="#33ff0000" Storyboard.TargetName="CloseBTNColor" Storyboard.TargetProperty="Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.15" To="Transparent" Storyboard.TargetName="CloseBTNColor" Storyboard.TargetProperty="Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Image Source="/Images/Buttons/close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                    </Grid>

                </Border>
            </Grid>
            
        </Border>
    </Grid>
</Window>
