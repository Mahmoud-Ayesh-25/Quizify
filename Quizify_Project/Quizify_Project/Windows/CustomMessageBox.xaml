<Window x:Class="Quizify_Project.Windows.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizify_Project.Windows"
        xmlns:class="clr-namespace:Quizify_Project.Classes"
        mc:Ignorable="d"
        Title="CustomMessageBox" Height="250" Width="400"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        MaxHeight="250" MaxWidth="400"
        MinHeight="250" MinWidth="400"
        RenderOptions.BitmapScalingMode="HighQuality"
        KeyDown="Window_KeyDown">

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" CenterX="200" CenterY="125" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Window.Resources>
        <class:clsHalfConverter x:Key="HalfConverter"></class:clsHalfConverter>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.3" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             From="0.7" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border CornerRadius="10" BorderBrush="#FF343D66" BorderThickness="2">

            <Border.Background>
                <ImageBrush ImageSource="/Images/Background/MainBackground.png"/>
            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="190"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Border Grid.Row="2" BorderBrush="#FF343D66" BorderThickness="2" CornerRadius="10" Padding="5" Margin="10 0 10 10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                        <TextBox Background="Transparent" IsReadOnly="True" x:Name="FullMessageText" Foreground="White" Text="" BorderThickness="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="15" TextWrapping="Wrap" Margin="10"></TextBox>
                        
                    </ScrollViewer>
                </Border>
                
                <Border Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="60"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CopyBTN" CornerRadius="5" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1"
                                    Margin="0 15 15 18" Opacity="0" IsEnabled="False" MouseDown="CopyBTN_MouseDown">
                                <Image Source="/Images/ButtonIcons/copy.png" Width="20" Height="20" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality"></Image>

                                <Border.Background>
                                    <SolidColorBrush x:Name="CopyBTNBackground" Color="Transparent"></SolidColorBrush>
                                </Border.Background>
                                
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CopyBTNScale" ScaleX="1" ScaleY="1" CenterX="12.5" CenterY="12.5"></ScaleTransform>
                                </Border.RenderTransform>
                                
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Duration="0:0:0.2" To="#33ffffff" Storyboard.TargetName="CopyBTNBackground" Storyboard.TargetProperty="Color"></ColorAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Duration="0:0:0.2" To="Transparent" Storyboard.TargetName="CopyBTNBackground" Storyboard.TargetProperty="Color"></ColorAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.05" To="0.9" Storyboard.TargetProperty="ScaleX" Storyboard.TargetName="CopyBTNScale"></DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.05" To="0.9" Storyboard.TargetProperty="ScaleY" Storyboard.TargetName="CopyBTNScale"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetProperty="ScaleX" Storyboard.TargetName="CopyBTNScale"></DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetProperty="ScaleY" Storyboard.TargetName="CopyBTNScale"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            
                            <Border x:Name="FullMessageBTN" Background="#08ffffff" BorderThickness="1.5" CornerRadius="10"
                                    Grid.Column="0" Margin="10 10 10 13" MouseUp="FullMessageBTN_MouseUp">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="FullMessageBTNScale" CenterX="{Binding ElementName=FullMessageBTN, Path=ActualWidth, Converter={StaticResource HalfConverter}}"
                                                    CenterY="{Binding ElementName=FullMessageBTN, Path=ActualHeight, Converter={StaticResource HalfConverter}}"
                                                    ScaleX="1" ScaleY="1"></ScaleTransform>
                                </Border.RenderTransform>
                                
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="DetailsBTNBorderColor" Color="#33ffffff"></SolidColorBrush>
                                </Border.BorderBrush>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="35"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Details" Foreground="#ccffffff" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                               Padding="0 0 0 2"></TextBlock>

                                    <Image Source="/Images/ButtonIcons/down.png" RenderOptions.BitmapScalingMode="HighQuality" Grid.Column="1"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">

                                        <Image.RenderTransform>
                                            <RotateTransform x:Name="FullMessageBTNArrowRotation" CenterX="8" CenterY="8" Angle="0"></RotateTransform>
                                        </Image.RenderTransform>
                                        
                                    </Image>
                                    
                                </Grid>

                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Duration="0:0:0.2" To="#eeffffff" Storyboard.TargetName="DetailsBTNBorderColor" Storyboard.TargetProperty="Color"></ColorAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Duration="0:0:0.2" To="#33ffffff" Storyboard.TargetName="DetailsBTNBorderColor" Storyboard.TargetProperty="Color"></ColorAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.05" To="0.93" Storyboard.TargetName="FullMessageBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.05" To="0.93" Storyboard.TargetName="FullMessageBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="FullMessageBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                                <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="FullMessageBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                
                            </Border>
                            
                            <StackPanel x:Name="ButtonsSP" Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0 0 10 13"></StackPanel>
                            
                        </Grid>

                            <Border Grid.Row="0">
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Image x:Name="MidImage" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="20" RenderOptions.BitmapScalingMode="HighQuality"></Image>

                                <TextBlock x:Name="SmallMessage" Text="" Grid.Column="1" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Margin="0 20 20 20" TextWrapping="Wrap" FontSize="20" Foreground="White"></TextBlock>
                                
                            </Grid>

                        </Border>
                        
                    </Grid>
                </Border>

                <Border Grid.Row="0" Background="#FF111731" CornerRadius="10 10 0 0" BorderThickness="1" BorderBrush="#FF343D66">

                    <Border.Effect>
                        <DropShadowEffect Direction="270" BlurRadius="50" Opacity="0.4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DragBorder" Background="Transparent" MouseDown="DragBorder_MouseDown" Grid.Column="0" Panel.ZIndex="2"/>

                        <TextBlock x:Name="EdgeText" Text="Error" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18 0 0 0" FontSize="25" Foreground="White"
                                   FontWeight="Bold" FontFamily="Calibri"></TextBlock>
                        
                        <Border x:Name="CloseBTN" CornerRadius="5" Grid.Column="1" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="CloseBTN_MouseUp">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33ff0000"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="/Images/Buttons/close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                    </Grid>

                </Border>
            </Grid>
            
        </Border>
    </Grid>
</Window>
