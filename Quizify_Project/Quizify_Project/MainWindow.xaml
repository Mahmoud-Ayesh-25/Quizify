<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quizify_Project"
        xmlns:classes="clr-namespace:Quizify_Project.Classes"
        xmlns:UserControls="clr-namespace:Quizify_Project.UserControls" x:Class="Quizify_Project.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="820" Width="1242"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        x:Name="MyWindow"
        MinWidth="895" MinHeight="540"
        StateChanged="MyWindow_StateChanged"
    RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="MyWindow_Loaded">


    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" CenterX="640" CenterY="360" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.3" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                 Storyboard.TargetProperty="ScaleX" 
                                 From="0.7" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale" 
                                 Storyboard.TargetProperty="ScaleY" 
                                 From="0.7" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="10" x:Name="MainBorder" Opacity="1" BorderThickness="1" BorderBrush="#FF343D66">



        <Border.Background>
            <ImageBrush ImageSource="/Images/Background/MainBackground.png"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <Border x:Name="BackShadowBorder" Panel.ZIndex="1000" Grid.Row="0" Grid.RowSpan="3" Background="#aa000000" Opacity="0" Visibility="Hidden" CornerRadius="10"></Border>

            <Frame x:Name="MainFrame" Grid.Row="1" Source="/Pages/Courses.xaml" JournalOwnership="UsesParentJournal"></Frame>

            <Border Background="Transparent" Width="5" x:Name="RightResize" HorizontalAlignment="Right" Panel.ZIndex="5" Grid.RowSpan="3" Cursor="SizeWE" 
                    MouseDown="RightResize_MouseDown" MouseMove="RightResize_MouseMove" MouseUp="RightResize_MouseUp"/>
            <Border Background="Transparent" Height="5" x:Name="BottomResize" VerticalAlignment="Bottom" Panel.ZIndex="5" Grid.Row="2" Cursor="SizeNS"
                    MouseDown="RightResize_MouseDown" MouseMove="RightResize_MouseMove" MouseUp="RightResize_MouseUp"/>

            <TextBlock Text="v1.4.11       Mahmoud Ayesh - Software Developer" FontSize="11" Margin="10 0" Foreground="#aaffffff" FontFamily="Microsoft YaHei" Grid.Row="2" RenderOptions.BitmapScalingMode="HighQuality"/>

            <Border Grid.Row="0" Background="#FF111731" CornerRadius="10 10 0 0" BorderThickness="1" BorderBrush="#FF343D66">

                <Border.Effect>
                    <DropShadowEffect Direction="270" BlurRadius="50" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="Transparent" MouseDown="Border_MouseDown" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="2"/>

                    <Image Source="/Images/Logo/Quizify.png" Grid.Column="0" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="5" Grid.Column="2" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="CloseBTN_MouseUp">
                            
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33ff0000"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Image Source="/Images/Buttons/close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                        <Border CornerRadius="5" Grid.Column="1" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="MaxBTN_MouseUp">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22ffffff"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Image Source="/Images/Buttons/max.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                        <Border CornerRadius="5" Grid.Column="0" Width="35" Height="35" VerticalAlignment="Center" HorizontalAlignment="Left" MouseUp="MinBTN_MouseUp">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22ffffff"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Image Source="/Images/Buttons/min.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Border>

                    </Grid>
                </Grid>

            </Border>
            <UserControls:Switch HorizontalAlignment="Left" Margin="97,49,0,0" Grid.Row="1" VerticalAlignment="Top"/>


        </Grid>
    </Border>

</Window>
