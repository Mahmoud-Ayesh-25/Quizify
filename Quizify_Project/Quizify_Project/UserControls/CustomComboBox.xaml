<UserControl x:Class="Quizify_Project.UserControls.CustomComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="200"
             RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <Border x:Name="MainBox" Background="#08ffffff" CornerRadius="10" MouseDown="MainBox_MouseDown" BorderThickness="1.5">

            <Border.BorderBrush>
                <SolidColorBrush x:Name="brdr" Color="#33ffffff"/>
            </Border.BorderBrush>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="25"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="SelectedText" Text="Select Item" Foreground="#ccffffff" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="10 0" FontSize="15" Grid.Column="0" FontFamily="Arial" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                <Image Source="/Images/ButtonIcons/down.png" Grid.Column="1" Opacity="0.8" MaxWidth="15" MaxHeight="15" Margin="0 0 10 0"/>

            </Grid>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.2" To="#eeffffff" Storyboard.TargetName="brdr" Storyboard.TargetProperty="Color"></ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.2" To="#33ffffff" Storyboard.TargetName="brdr" Storyboard.TargetProperty="Color"></ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
        </Border>
        
        <Popup x:Name="MyPopup" PlacementTarget="{Binding ElementName=MainBox}" Placement="Relative" StaysOpen="False" 
               Width="{Binding ElementName=MainBox, Path=ActualWidth}" AllowsTransparency="True">

            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ElementName=MainBox, Path=ActualHeight}"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Border Background="#08ffffff"  BorderThickness="1" CornerRadius="10" Grid.Row="1">

                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="listBrdr" Color="#33ffffff"/>
                        </Border.BorderBrush>

                        <StackPanel x:Name="Items">
                        </StackPanel>
                        
                    </Border>
                </Grid>
                
            </Border>
        </Popup>
    </Grid>
</UserControl>
