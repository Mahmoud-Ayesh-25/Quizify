<UserControl x:Class="Quizify_Project.UserControls.ComboBoxItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="150"
             Height="35"
             RenderOptions.BitmapScalingMode="HighQuality">
    <Grid>
        <Border CornerRadius="10" Margin="2" BorderThickness="1">
            
            <Border.Background>
                <SolidColorBrush x:Name="background" Color="#44000000"/>
            </Border.Background>

            <Border.BorderBrush>
                <SolidColorBrush x:Name="BorderColor" Color="Transparent"></SolidColorBrush>
            </Border.BorderBrush>

            <TextBlock x:Name="txt" Text="ItemName" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0" Padding="0 0 0 1">
                
                <TextBlock.Foreground>
                    <SolidColorBrush x:Name="FontColor" Color="#aaffffff"/>
                </TextBlock.Foreground>
                
            </TextBlock>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.2" To="#66000000" Storyboard.TargetName="background" Storyboard.TargetProperty="Color"></ColorAnimation>
                            <ColorAnimation Duration="0:0:0.2" To="#ffffffff" Storyboard.TargetName="FontColor" Storyboard.TargetProperty="Color"></ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.2" To="#44000000" Storyboard.TargetName="background" Storyboard.TargetProperty="Color"></ColorAnimation>
                            <ColorAnimation Duration="0:0:0.2" To="#aaffffff" Storyboard.TargetName="FontColor" Storyboard.TargetProperty="Color"></ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
        </Border>
    </Grid>
</UserControl>
