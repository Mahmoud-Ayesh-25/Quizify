<UserControl x:Class="Quizify_Project.UserControls.ucAnswerReview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             xmlns:class="clr-namespace:Quizify_Project.Classes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             x:Name="AnswerReview"
             Opacity="1"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <class:clsHalfConverter x:Key="HalfConverter"></class:clsHalfConverter>
    </UserControl.Resources>
    
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"
                        CenterX="{Binding ElementName=AnswerReview, Path=ActualWidth, Converter={StaticResource HalfConverter}}"
                        CenterY="{Binding ElementName=AnswerReview, Path=ActualHeight, Converter={StaticResource HalfConverter}}"></ScaleTransform>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:1" From="0" To="1" Storyboard.TargetProperty="ScaleX" Storyboard.TargetName="Scale">
                        <DoubleAnimation.EasingFunction>
                            <QuinticEase></QuinticEase>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:1" From="0" To="1" Storyboard.TargetProperty="ScaleY" Storyboard.TargetName="Scale">
                        <DoubleAnimation.EasingFunction>
                            <QuinticEase></QuinticEase>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:0.4" From="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="AnswerReview"></DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid>
        <Border BorderThickness="2" CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                    <GradientStop Color="#FF2D2E53" Offset="0.1"></GradientStop>
                    <GradientStop Color="#FF2B2B4C" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                    <GradientStop x:Name="OutLine1" Color="#FF4D4D6B" Offset="0.1"></GradientStop>
                    <GradientStop x:Name="OutLine2" Color="#FF4D4D6B" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="QuestionRow"></RowDefinition>
                    <RowDefinition x:Name="YourAnswer"></RowDefinition>
                    <RowDefinition x:Name="CurrectAnswer"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                </Grid.RowDefinitions>

                              
                
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <TextBlock x:Name="QuestionNumberText" Text="1/10" FontSize="25" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                                FontFamily="Agency FB" Grid.Column="1" Margin="5"></TextBlock>

                    <TextBlock Foreground="White" Text="Question:" FontWeight="Bold" Margin="10"
                               VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                    
                    <TextBox Grid.Row="1" x:Name="QuestionText" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Margin="5 0" Foreground="White"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Background="Transparent" RenderOptions.BitmapScalingMode="HighQuality"></TextBox>

                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="White" Text="Your Answer:" FontWeight="Bold" Margin="10"
                               VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                    
                    <TextBox Grid.Row="1" x:Name="UserAnswerText" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Margin="5 0" Foreground="White"
                            VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Background="Transparent" RenderOptions.BitmapScalingMode="HighQuality">
                    </TextBox>

                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="White" Text="Correct Answer:" FontWeight="Bold" Margin="10"
                               VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                    
                    <TextBox Grid.Row="1" x:Name="AnswerText" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Margin="5 0" Foreground="White"
                            VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Background="Transparent" RenderOptions.BitmapScalingMode="HighQuality">
                    </TextBox>

                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ScoreContainer"></StackPanel>

            </Grid>
            
        </Border>
    </Grid>
</UserControl>
