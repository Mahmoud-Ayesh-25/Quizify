<UserControl x:Class="Quizify_Project.UserControls.CustomTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400">

    <Grid>
        <Border Background="#08ffffff" BorderThickness="1.5" CornerRadius="10">

            <Border.BorderBrush>
                <SolidColorBrush x:Name="brdr" Color="#33ffffff"></SolidColorBrush>
            </Border.BorderBrush>

                <Grid>
                <TextBox Panel.ZIndex="1" x:Name="txtBx" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Foreground="White"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="10 0" FontSize="15" CaretBrush="White" LostFocus="txtBx_LostFocus"
                         TextChanged="txtBx_TextChanged">
                    <TextBox.Triggers>
                        <EventTrigger RoutedEvent="GotFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Duration="0:0:0.2" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ImageAndSearchPanal"></DoubleAnimation>
                                    <ColorAnimation Duration="0:0:0.2" To="#eeffffff" Storyboard.TargetProperty="Color" Storyboard.TargetName="brdr"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="LostFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Duration="0:0:0.2" To="#33ffffff" Storyboard.TargetProperty="Color" Storyboard.TargetName="brdr"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBox.Triggers>
                </TextBox>

                <StackPanel Panel.ZIndex="0" x:Name="ImageAndSearchPanal" VerticalAlignment="Center" Orientation="Horizontal" Opacity="1">
                    <TextBlock x:Name="TextBXBackText" Text="Type Here..." VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#55ffffff" FontSize="15" Margin="10 0 0 2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
