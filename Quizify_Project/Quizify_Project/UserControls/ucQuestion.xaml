<UserControl x:Class="Quizify_Project.UserControls.ucQuestion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="QuestionUC"
             Loaded="QuestionUC_Loaded"
             RenderOptions.BitmapScalingMode="HighQuality">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition x:Name="QuestionRow"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition x:Name="AnswerRow"></RowDefinition>
            <RowDefinition Height="2"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Question:" FontSize="25" Foreground="White" VerticalAlignment="Center" FontFamily="Agency FB" Margin="5"></TextBlock>
            <TextBlock x:Name="QuestionNumberText" Text="1/10" FontSize="25" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontFamily="Agency FB" Grid.Column="1" Margin="5"></TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <local:Switch x:Name="QuestionRTLSwitch" Width="40" Height="20" OnStatusChanged="QuestionRTLSwitch_OnStatusChanged"></local:Switch>
                <TextBlock x:Name="QuestionRTLText" Text="Right To Left" FontSize="17" Foreground="White" VerticalAlignment="Center" FontFamily="Arial" Margin="5" HorizontalAlignment="Right"></TextBlock>
            </StackPanel>

        </Grid>

        <TextBox x:Name="QuestionText" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Margin="5" Foreground="White"
                 VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Background="Transparent" Grid.Row="1"></TextBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Your Answer:" FontSize="25" Foreground="White" VerticalAlignment="Center" FontFamily="Agency FB" Margin="5" Grid.Row="2"></TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <local:Switch x:Name="AnswerRTLSwitch" Width="40" Height="20" OnStatusChanged="AnswerRTLSwitch_OnStatusChanged"></local:Switch>
                <TextBlock Name="AnswerRTLText" Text="Right To Left" FontSize="17" Foreground="White" VerticalAlignment="Center" FontFamily="Arial" Margin="5" HorizontalAlignment="Right"></TextBlock>
            </StackPanel>

        </Grid>
        
        <local:CustomTextBox x:Name="AnswerTextBX" Grid.Row="3" Margin="5 5 5 10" OnTextChanged="CustomTextBox_OnTextChanged" TextWrapping="Wrap"></local:CustomTextBox>

            <Rectangle Grid.Row="4">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0 0.5" EndPoint="1 0.5">
                    <GradientStop Color="Transparent" Offset="1"></GradientStop>
                    <GradientStop x:Name="UnderLineColor1" Color="White" Offset="0.95"></GradientStop>
                    <GradientStop x:Name="UnderLineColor2" Color="White" Offset="0.5"></GradientStop>
                    <GradientStop x:Name="UnderLineColor3" Color="White" Offset="0.05"></GradientStop>
                    <GradientStop Color="Transparent" Offset="0"></GradientStop>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    </Grid>
</UserControl>
