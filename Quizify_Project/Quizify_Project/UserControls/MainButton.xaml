<UserControl x:Class="Quizify_Project.UserControls.MainButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quizify_Project.UserControls"
             mc:Ignorable="d" 
             Width="315" Height="165"
             Margin="15.7"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.RenderTransform>
        <ScaleTransform x:Name="BTNScale" CenterX="157.5" CenterY="82.5" ScaleX="1" ScaleY="1"></ScaleTransform>
    </UserControl.RenderTransform>

    <Grid>
        <Border CornerRadius="12" BorderThickness="2" Opacity="1" x:Name="MainBorder">

            <Border.Effect>
                <DropShadowEffect Direction="300" Opacity="0.4" BlurRadius="10"/>
            </Border.Effect>

            <Border.Background>
                <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                    <GradientStop Color="{Binding MainBackgroundColorUp}" Offset="0.1"></GradientStop>
                    <GradientStop Color="{Binding MainBackgroundColorDown}" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                                <GradientStop Color="{Binding BorderColorUp}" Offset="0.1"></GradientStop>
                                <GradientStop Color="{Binding BorderColorDown}" Offset="1"></GradientStop>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                                        <GradientStop Color="{Binding MouseEnterBorderColor}" Offset="0.1"></GradientStop>
                                        <GradientStop Color="{Binding MouseEnterBorderColor}" Offset="1"></GradientStop>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="0.35*"></RowDefinition>
                </Grid.RowDefinitions>

                <Border CornerRadius="0 0 12 12"
                        Grid.Row="1" Grid.ColumnSpan="2">
                    <Border.Background>
                        <SolidColorBrush x:Name="ButtomAreaColor" Color="{Binding LessonsCountAreaBackgroundColor}"/>
                    </Border.Background>
                </Border>

                <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10">
                    <TextBlock.Effect>
                        <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="5" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>


                <TextBlock Text="{Binding LessonsCount}" Foreground="#eeffffff" FontSize="14"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" Grid.Row="1" FontFamily="Arial"/>

                <Grid Grid.Column="1" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27.5"/>
                        <RowDefinition/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="OptionsButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Opacity" Value="1"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border x:Name="EditBTN" Height="20" Margin="7.5 7.5 7.5 0" ToolTip="Edit" MouseDown="EditBTN_MouseDown" MouseUp="EditBTN_MouseUp" Tag="">
                            <Image Source="/Images/ButtonIcons/pencil.png" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="EditBTNScale" ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.7"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="MouseDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.05" To="0.95" Storyboard.TargetName="EditBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                            <DoubleAnimation Duration="0:0:0.05" To="0.95" Storyboard.TargetName="EditBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="EditBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="EditBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                        </Border>

                        <Border x:Name="RemoveBTN" Height="20" Margin="7.5 7.5 7.5 0" ToolTip="Remove" MouseDown="EditBTN_MouseDown" MouseUp="RemoveBTN_MouseUp" Tag="">
                            <Image Source="/Images/ButtonIcons/remove.png" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RemoveBTNScale" ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.7"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="MouseDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.05" To="0.95" Storyboard.TargetName="RemoveBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                            <DoubleAnimation Duration="0:0:0.05" To="0.95" Storyboard.TargetName="RemoveBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="RemoveBTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="RemoveBTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                            </Border.Triggers>

                        </Border>

                    </StackPanel>

                    <Image x:Name="MainImage" Source="{Binding IconPath}" Grid.Row="1" RenderOptions.BitmapScalingMode="HighQuality"></Image>

                </Grid>

            </Grid>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.05" To="1.04" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                            <DoubleAnimation Duration="0:0:0.05" To="1.04" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                            <DoubleAnimation Duration="0:0:0.05" To="1" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation x:Name="ClickAnim1" Duration="0:0:0.05" To="1.02" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                            <DoubleAnimation x:Name="ClickAnim2" Duration="0:0:0.05" To="1.02" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.05" To="1.04" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleX"></DoubleAnimation>
                            <DoubleAnimation Duration="0:0:0.05" To="1.04" Storyboard.TargetName="BTNScale" Storyboard.TargetProperty="ScaleY"></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Border.Triggers>
            
        </Border>
    </Grid>
</UserControl>
